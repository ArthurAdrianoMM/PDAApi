        ]
      }
    },
    "/notas": {
      "get": {
        "operationId": "obterNotas",
        "tags": [
          "Desempenho"
        ],
        "summary": "Notas",
        "description": "Retorna as notas de cada disciplina da matrícula que a sessão está usando, com uma entrada por avaliação. O período respondido vem em `periodo`.\n\n> [!WARNING]\n> **Avaliações mudam de nome**\n>\n> O portal manda cada avaliação como uma coluna com nome livre, como `1 - AV 1 / AV QT 1`. Aqui elas viram itens de `avaliacoes[]`: `etapa` é o número antes do hífen e `nome` o texto depois. Leia pelo `etapa`, nunca pela posição.\n\n> [!NOTE]\n> **Valor e nota**\n>\n> `valor` é o texto como o portal envia. `nota` é o mesmo valor como número quando ele é numérico (com vírgula ou ponto) e `null` nos outros casos, como avaliações ainda sem nota.\n\n> [!NOTE]\n> **De onde vêm os dados**\n>\n> O servidor local chama `TOTVSEducacional/NotaEtapa` no portal. A resposta vai do portal para o seu computador e para mais nenhum lugar.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Notas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "periodo": {
                      "type": "string",
                      "description": "Código do período da matrícula da sessão (ex.: `2026S2`)."
                    },
                    "disciplinas": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "idTurmaDisc": {
                            "type": "integer",
                            "description": "ID da turma da disciplina. Combina com `/disciplinas`."
                          },
                          "codigo": {
                            "type": "string",
                            "description": "Código da disciplina (`CODDISC`)."
                          },
                          "nome": {
                            "type": "string",
                            "description": "Nome da disciplina."
                          },
                          "turma": {
                            "type": "string",
                            "description": "Código da turma (`CODTURMA`)."
                          },
                          "situacao": {
                            "description": "Situação na disciplina, como o portal envia.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "avaliacoes": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "etapa": {
                                  "type": "integer",
                                  "description": "Número da etapa, o que vem antes do hífen no nome da coluna do portal."
                                },
                                "nome": {
                                  "type": "string",
                                  "description": "Nome da avaliação, o texto depois do hífen (ex.: `AV 1 / AV QT 1`)."
                                },
                                "valor": {
                                  "description": "O valor como o portal envia, ou `null` quando vazio.",
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "nota": {
                                  "description": "`valor` como número quando ele é numérico; senão `null`.",
                                  "type": [
                                    "number",
                                    "null"
                                  ]
                                }
                              },
                              "required": [
                                "etapa",
                                "nome",
                                "valor",
                                "nota"
                              ],
                              "additionalProperties": false
                            },
                            "description": "Uma por avaliação, em ordem de etapa."
                          }
                        },
                        "required": [
                          "idTurmaDisc",
                          "codigo",
                          "nome",
                          "turma",
                          "situacao",
                          "avaliacoes"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "periodo",
                    "disciplinas"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "periodo": "2026S2",
                  "disciplinas": [
                    {
                      "idTurmaDisc": 48213,
                      "codigo": "PW2",
                      "nome": "Programação Web II",
                      "turma": "DS-2026-A",
                      "situacao": "Cursando",
                      "avaliacoes": [
                        {
                          "etapa": 1,
                          "nome": "AV 1 / AV QT 1",
                          "valor": "8,5",
                          "nota": 8.5
                        },
                        {
                          "etapa": 3,
                          "nome": "AV 3 / AV QT 3",
                          "valor": null,
                          "nota": null
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "`parametro_invalido`: Um parâmetro está faltando, sobrando ou com o tipo errado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "parametro_invalido": {
                    "summary": "parametro_invalido",
                    "value": {
                      "erro": "parametro_invalido",
                      "mensagem": "Um parâmetro está faltando, sobrando ou com o tipo errado."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "`token_invalido`: O token local está ausente ou errado. Use o link ou o token que o terminal mostrou.\n\n`login_falhou`: O portal não completou o login. Confira o usuário e a senha.\n\n`sessao_expirada`: O portal recusou a sessão, e um novo login não resolveu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "token_invalido": {
                    "summary": "token_invalido",
                    "value": {
                      "erro": "token_invalido",
                      "mensagem": "O token local está ausente ou errado. Use o link ou o token que o terminal mostrou."
                    }
                  },
                  "login_falhou": {
                    "summary": "login_falhou",
                    "value": {
                      "erro": "login_falhou",
                      "mensagem": "O portal não completou o login. Confira o usuário e a senha."
                    }
                  },
                  "sessao_expirada": {
                    "summary": "sessao_expirada",
                    "value": {
                      "erro": "sessao_expirada",
